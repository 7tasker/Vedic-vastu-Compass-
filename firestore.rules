rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // System configurations (app icon, branding, menu_nav, theme, admob, etc.)
    match /system_config/{docId} {
      allow read, write: if true;
    }

    // System settings
    match /system_settings/{docId} {
      allow read, write: if true;
    }

    // App content (push notifications, legal & info)
    match /app_content/{docId} {
      allow read, write: if true;
    }

    // Vastu Knowledge Rules Repository
    match /vastu_knowledge_db/{docId} {
      allow read, write: if true;
    }

    // User profiles & accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit reports
    match /audit_reports/{reportId} {
      allow read, write: if true;
    }

    // Payments & transactions
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /payment_records/{recordId} {
      allow read, write: if true;
    }

    // Consultations
    match /consultations/{consultId} {
      allow read, write: if true;
    }

    // AdSense tracking
    match /adsense_reports/{docId} {
      allow read, write: if true;
    }

    // Geotag & security logs
    match /geotag_logs/{logId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Default permission
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
